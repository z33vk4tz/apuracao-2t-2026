# Troque pelo seu domínio. O Caddy obtém e renova o HTTPS sozinho.
{$DOMINIO:localhost} {
	root * /srv/web
	encode zstd gzip
	file_server
	@dados path /data/resultado.json
	header @dados Cache-Control "no-store"
	@geo path /data/geo-* /data/municipios.json
	header @geo Cache-Control "public, max-age=86400"
}
